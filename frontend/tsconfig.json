{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/mobile/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src/mobile/**/*.ts",
    "src/mobile/**/*.tsx"
  ]
}